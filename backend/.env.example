APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_EXPIRES_HOURS=8
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/banking
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example, one origin, no wildcard:
# CORS_ORIGINS=https://frontend-six-gules-49.vercel.app
AUTO_CREATE_TABLES=1
AUTO_SEED_ADMIN=1
RATELIMIT_ENABLED=1
TRUST_PROXY=0
PORT=5000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator
